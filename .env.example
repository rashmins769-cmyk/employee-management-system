# MONGODB_URI: MongoDB connection string (e.g. mongodb://localhost:27017/gupio_ems or MongoDB Atlas URI)
MONGODB_URI="mongodb://localhost:27017/gupio_ems"

# PORT: Server listening port (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Application URL
APP_URL="MY_APP_URL"
